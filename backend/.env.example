# Sloy Backend Configuration

# Feature Flags - Hybrid Architecture Modules
USE_ML_SEGMENTATION=false
USE_CAD_SOLVER=false
USE_CURVE_FITTING=false
USE_MULTI_PASS_VECTORIZATION=false

# CAD Solver Parameters
CAD_SNAP_RADIUS=3.0
CAD_ANGLE_TOLERANCE=3.0
CAD_MIN_INSIDE_RATIO=0.90

# Performance Settings
MAX_IMAGE_SIZE=3000
PROCESSING_TIMEOUT=30

# CORS Settings
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
